#!/bin/bash
# Resolves app directory (defaults to local app directory or /Users/davidjunior/dev/parrot/app)
LOCAL_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )/../../.." >/dev/null 2>&1 && pwd )"
if [ -f "$LOCAL_DIR/main.py" ]; then
    DIR="$LOCAL_DIR"
else
    DIR="/Users/davidjunior/dev/parrot/app"
fi
cd "$DIR"

if [ -f "$DIR/.venv/bin/python3" ]; then
    exec "$DIR/.venv/bin/python3" "$DIR/main.py"
else
    exec python3 "$DIR/main.py"
fi
